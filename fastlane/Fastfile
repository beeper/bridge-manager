# frozen_string_literal: true

UI.user_error!('Please run fastlane via `bundle exec`') unless FastlaneCore::Helper.bundler?

require 'fileutils'

PROJECT_ROOT_FOLDER = File.dirname(File.expand_path(__dir__))

APPLE_TEAM_ID = 'PZYM8XX95Q'
SIGNING_IDENTITY = "Developer ID Application: Automattic, Inc. (#{APPLE_TEAM_ID})"

CODE_SIGNING_STORAGE_OPTIONS = {
  storage_mode: 's3',
  s3_bucket: 'a8c-fastlane-match',
  s3_region: 'us-east-2'
}.freeze

CODE_SIGNING_ENV_VARS = %w[
  MATCH_S3_ACCESS_KEY
  MATCH_S3_SECRET_ACCESS_KEY
  MATCH_PASSWORD
].freeze

ASC_API_KEY_ENV_VARS = %w[
  APP_STORE_CONNECT_API_KEY_KEY_ID
  APP_STORE_CONNECT_API_KEY_ISSUER_ID
  APP_STORE_CONNECT_API_KEY_KEY
].freeze

require 'fastlane/plugin/wpmreleasetoolkit'

EnvManager = Fastlane::Wpmreleasetoolkit::EnvManager

before_all do
  # Sets up a temporary keychain so match works in CI. No-op locally.
  setup_ci

  # `set_up` is needed even with no `.env` file so EnvManager has a configured
  # instance; on CI the vars come from the Buildkite agent.
  EnvManager.set_up(env_file_name: 'bridge-manager.env')
end

desc 'Fetch the Developer ID Application certificate into the keychain'
lane :set_up_signing do |readonly: true|
  CODE_SIGNING_ENV_VARS.each { |k| EnvManager.get_required_env!(k) }
  ASC_API_KEY_ENV_VARS.each { |k| EnvManager.get_required_env!(k) } unless readonly

  sync_code_signing(
    type: 'developer_id',
    platform: 'macos',
    team_id: APPLE_TEAM_ID,
    app_identifier: [],
    api_key: readonly ? nil : app_store_connect_api_key,
    readonly: readonly,
    **CODE_SIGNING_STORAGE_OPTIONS
  )
end

desc 'Sign macOS binaries with the Developer ID certificate, verify them, and notarize them. Run `set_up_signing` first'
lane :sign_and_notarize do |binaries:|
  ASC_API_KEY_ENV_VARS.each { |k| EnvManager.get_required_env!(k) }

  paths = binaries.split(',').map { |binary| File.absolute_path(binary, PROJECT_ROOT_FOLDER) }

  paths.each do |path|
    sh('codesign', '--sign', SIGNING_IDENTITY, '--options', 'runtime', '--timestamp', '--force', path)
  end

  # A bare binary can't be stapled, and Gatekeeper's online lookup lags a fresh submission.
  macos_verify_code_signing(
    artifact_path: paths,
    expected_authority: SIGNING_IDENTITY,
    verify_hardened_runtime: true,
    verify_notarization: false
  )

  api_key = app_store_connect_api_key
  paths.each do |path|
    # `notarytool` only takes archives, and `notarize` only archives `.app` bundles itself.
    archive = "#{path}.zip"
    sh('ditto', '-c', '-k', '--keepParent', path, archive)
    notarize(package: archive, skip_stapling: true, api_key: api_key, print_log: true)
    FileUtils.rm_f(archive)
  end
end
